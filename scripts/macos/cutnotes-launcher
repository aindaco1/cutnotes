#!/bin/sh
set -eu

launcher_path=$0
while [ -L "$launcher_path" ]; do
  link_target=$(readlink "$launcher_path")
  case "$link_target" in
    /*) launcher_path=$link_target ;;
    *) launcher_path=$(dirname -- "$launcher_path")/$link_target ;;
  esac
done

launcher_dir=$(CDPATH= cd -- "$(dirname -- "$launcher_path")" && pwd)
resources_dir=$(CDPATH= cd -- "$launcher_dir/../.." && pwd)
python_bin="$resources_dir/Runtime/Python.framework/Versions/3.14/bin/python3"

if [ ! -x "$python_bin" ]; then
  echo "cutnotes: the bundled Python runtime is missing; reinstall CutNotes.app" >&2
  exit 3
fi

export CUTNOTES_FFMPEG="$resources_dir/Runtime/bin/ffmpeg"
export CUTNOTES_FFPROBE="$resources_dir/Runtime/bin/ffprobe"
export CUTNOTES_LOCAL_ENGINE="$resources_dir/Helpers/CutNotesLocal"
export PYTHONDONTWRITEBYTECODE=1

exec "$python_bin" "$resources_dir/CLI/cutnotes" "$@"
